# Fournisseur par défaut (groq | ollama | precomputed)
SCREENING_PROVIDER=groq

# Groq cloud — ajouter la valeur dans .env local ou dans les secrets du Space.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Ollama — l'URL ci-dessous correspond au service Docker Compose.
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://ollama:11434/v1

# La saisie libre est désactivée dans la démo publique.
SCREENING_ALLOW_CUSTOM_TEXT=false
